# Environment files with real credentials
.env
**/.env

# OS cruft
.DS_Store

# Generated output from running the demo flows — keep the folders, not their contents
03-first-flows/data-out/*
!03-first-flows/data-out/.gitkeep

# JDBC driver jars — re-fetch with 04-data-ingestion/drivers/download.sh
