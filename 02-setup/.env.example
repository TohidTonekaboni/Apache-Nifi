# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real credentials.

# Login used at https://localhost:8443/nifi
NIFI_USERNAME=admin
# Must be at least 12 characters — NiFi's single-user provider will refuse shorter passwords.
NIFI_PASSWORD=ChangeThisPassword123!

# Host port mapped to NiFi's HTTPS listener (container always listens on 8443 internally)
NIFI_WEB_HTTPS_PORT=8443

# Only used if you start the optional nifi-registry service (--profile registry)
NIFI_REGISTRY_HTTP_PORT=18080

# Section 4 — Postgres source for the QueryDatabaseTable exercise (always started)
POSTGRES_USER=nifi
POSTGRES_PASSWORD=nifi_password
POSTGRES_DB=sourcedb
POSTGRES_PORT=5432

# Section 4 — optional Kafka-compatible broker (--profile kafka)
REDPANDA_KAFKA_PORT=9092

# Section 4 — optional HTTP test service for InvokeHTTP (--profile http)
HTTPBIN_PORT=8080

# Section 4 — ListenHTTP webhook-receiver exercise (always available on the nifi container)
LISTENHTTP_PORT=9091

# Section 6 — optional SFTP destination for PutSFTP (--profile sftp)
SFTP_PORT=2222
SFTP_PASSWORD=sftp_password

# Section 6 — optional S3-compatible storage via LocalStack for PutS3Object (--profile s3)
LOCALSTACK_PORT=4566
