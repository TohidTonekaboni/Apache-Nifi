# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real credentials.

# Login used at https://localhost:8443/nifi
NIFI_USERNAME=admin
# Must be at least 12 characters — NiFi's single-user provider will refuse shorter passwords.
NIFI_PASSWORD=ChangeThisPassword123!

# Host port mapped to NiFi's HTTPS listener (container always listens on 8443 internally)
NIFI_WEB_HTTPS_PORT=8443

# Only used if you start the optional nifi-registry service (--profile registry)
NIFI_REGISTRY_HTTP_PORT=18080
